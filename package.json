    "focus-trap-react": "^10.3.1",
    "framer-motion": "^11.11.17",
    "html-to-image": "^1.11.11",
    "i18next": "^23.16.8",
    "lucide-react": "^0.454.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
