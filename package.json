    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/marcellus": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
